rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    function isMemberAfter(householdId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberUids.hasAny([request.auth.uid]);
    }

    function isOwner(householdId) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'ownerUid', 'memberUids', 'inviteCode'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids.hasOnly([request.auth.uid]);

      allow read: if isMember(householdId);

      allow update: if signedIn() && (
        (
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids.hasAny([resource.data.ownerUid])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        )
        ||
        (
          exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.active == true
          && get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.householdId == householdId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasAny([request.auth.uid])
        )
      );

      allow delete: if isOwner(householdId);
    }

    match /invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.code == inviteCode
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerUid == request.auth.uid;

      allow update, delete: if isOwner(resource.data.householdId);
    }

    match /households/{householdId}/{subcollection}/{documentId} {
      allow read: if isMember(householdId);
      allow create, update, delete: if isMemberAfter(householdId);
    }
  }
}
